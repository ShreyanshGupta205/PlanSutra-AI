# PlanSutra AI Environment Configuration Template

# Server Port
PORT=3001

# Google Gemini API Key (Server-side ONLY, never exposed to client)
# Obtain from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Selected Gemini Model
GEMINI_MODEL=gemini-3.5-flash-lite

# Admin Secret Key (Server-verified authentication token for /admin)
# Set a strong, cryptographically generated random secret token for production (e.g. openssl rand -hex 32)
ADMIN_SECRET_KEY=your_admin_secret_key_here

# Optional: Supabase Configuration for Centralized Templates / Audit if deployed with Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
